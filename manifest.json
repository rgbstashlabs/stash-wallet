{
    "manifest_version": 3,
    "name": "Stash Wallet",
    "version": "0.0.14",
    "description": "Stash Wallet — Bitcoin & RGB Lightning wallet",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "public/popup.html",
        "default_icon": "icons/icon48.png"
    },
    "side_panel": {
        "default_path": "public/sidepanel.html"
    },
    "background": {
        "service_worker": "service-worker.js",
        "type": "module"
    },
    "permissions": [
        "storage",
        "alarms",
        "clipboardWrite",
        "notifications",
        "sidePanel"
    ],
    "host_permissions": [
        "https://blockstream.info/*",
        "https://mempool.space/*",
        "https://rgbdex.net/*",
        "https://www.rgbdex.net/*",
        "https://*.rgbdex.net/*",
        "https://*.stashlabs.io/*",
        "https://*.stashcloud.net/*"
    ],
    "externally_connectable": {
        "matches": [
            "https://rgbdex.net/*",
            "https://www.rgbdex.net/*",
            "https://regtest.rgbdex.net/*",
            "https://test.rgbdex.net/*"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "https://*/*"
            ],
            "js": [
                "content/inject.js"
            ],
            "run_at": "document_start",
            "all_frames": false
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "content/page-inject.js",
                "issuers/*"
            ],
            "matches": [
                "https://*/*"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    }
}
